# Copy to .env and fill in. .env is gitignored and key material is stripped from logs and
# cached responses by the redaction layer.

# Sarvam API key (dashboard.sarvam.ai). Required only for --llm; everything else is offline.
SARVAM_API_KEY=

# Rupee ceiling for one labeling run. The budget guard stops before exceeding it and leaves
# the cache intact, so the run resumes rather than restarting. Measured cost is roughly
# Rs 0.08/conversation, dominated by reasoning tokens, which bill as output.
AGENTTRACE_RUN_BUDGET_INR=25

# Set to 1 to refuse all network calls (heuristic labeler and fixture corpus only).
AGENTTRACE_OFFLINE=0
